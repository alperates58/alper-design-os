# Benchmark Web Server Dockerfile for Broken & Golden Web Apps
# Official trusted Node 22 Alpine image
FROM node:22-alpine

WORKDIR /app

# Non-root user for least privilege security
RUN chown -R node:node /app
USER node

# Copy benchmark app assets and server
COPY --chown=node:node benchmarks/ ./benchmarks/

ENV PORT=8080
ENV HOST=0.0.0.0
ENV NODE_ENV=production

EXPOSE 8080

CMD ["node", "benchmarks/server.js"]
