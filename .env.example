# ==============================================================================
# ALPER DESIGN OS - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Root directory of Alper Design OS (automatically resolved if omitted)
# Example: C:\Users\<Username>\Desktop\alper-design-os
ALPER_DESIGN_OS_HOME=

# Operational Mode (NEW | REPAIR | MODERNIZE)
ALPER_DESIGN_OS_DEFAULT_MODE=NEW

# MCP Server Configuration
ALPER_DESIGN_OS_MCP_PORT=3300
ALPER_DESIGN_OS_MCP_TRANSPORT=stdio
ALPER_DESIGN_OS_LOG_LEVEL=info

# External Discovery API Keys (Optional - Catalog search works offline by default)
PUBLIC_APIS_API_KEY=
AWESOME_MCP_GITHUB_TOKEN=
